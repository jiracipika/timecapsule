{
  "expo": {
    "name": "TimeCapsule",
    "slug": "timecapsule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF9500"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timecapsule.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF9500"
      },
      "package": "com.timecapsule.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TimeCapsule to access your photos.",
          "cameraPermission": "Allow TimeCapsule to use your camera."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow TimeCapsule to access your microphone for voice memos."
        }
      ]
    ],
    "scheme": "timecapsule",
    "experiments": {
      "typedRoutes": true
    }
  }
}
